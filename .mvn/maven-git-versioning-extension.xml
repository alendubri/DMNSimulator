<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns="https://github.com/qoomon/maven-git-versioning-extension">
    <describeTagPattern>v[0-9]+\.[0-9]+\.[0-9]+</describeTagPattern>
    <refs considerTagsOnBranches="true">
        <ref type="tag">
            <pattern>v(?&lt;version&gt;[0-9]+\.[0-9]+\.[0-9]+)</pattern>
            <version>${ref.version}</version>
            <properties>
                <build.sha>${commit.short}</build.sha>
            </properties>
        </ref>
        <ref type="branch">
            <pattern>.+</pattern>
            <version>${describe.tag.version:-1.6.0}.${describe.distance:-0}</version>
            <properties>
                <build.sha>${commit.short}</build.sha>
            </properties>
        </ref>
    </refs>
    <rev>
        <version>${describe.tag.version:-1.6.0}.${describe.distance:-0}</version>
        <properties>
            <build.sha>${commit.short}</build.sha>
        </properties>
    </rev>
</configuration>
