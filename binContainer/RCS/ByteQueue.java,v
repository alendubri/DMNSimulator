package binContainer;

public class ByteQueue extends BinQueue {

	public ByteQueue(int s) {
		size = s;
		queue = new Byte[size];
		for(int i = 0; i < size; i++)
			queue[i] = new Byte();
	}

	public Byte seeTopQueue() {
		return (Byte) queue[size - 1];
	}

	public Byte seeElement(int pos) {
		if ((pos >= 0) && (pos < size))
			return (Byte) queue[pos];
		else
			return (Byte) queue[0];
	}

}

